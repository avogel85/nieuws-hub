  # --- Onderzoeksjournalistiek (investigative journalism; verified 2026-09-26) ---
  # They publish a few stories a week, so max_age keeps 30 days instead of cache.max_age.
  # Note: ftm.nl often stalls new connections (seen 2026-09-26); the fetcher retries with backoff.
  - { id: ftm,            name: "Follow the Money", category: onderzoek, url: "https://www.ftm.nl/feed/", homepage: "https://www.ftm.nl", lang: nl, interval: 1h, max_age: 720h, paywall: true }
